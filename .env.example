# MongoDB Atlas (free M0 cluster) — Atlas dashboard → Connect → Drivers
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hpb?retryWrites=true&w=majority"
MONGODB_DB="hpb"

# Auth.js — generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (only needed once file attachments are added — free tier, 1GB)
# BLOB_READ_WRITE_TOKEN=""
